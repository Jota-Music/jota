<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Camera captures are written here and shared with the camera app via the
         FileProvider. -->
    <cache-path name="captures" path="captures/" />
    <!-- Release APK staged by the update pipeline, handed to the system
         package installer. -->
    <files-path name="updates" path="updates/" />
    <!-- Log copy staged by SaveLogs, handed to the system share chooser. -->
    <files-path name="logs" path="logs/" />
</paths>
