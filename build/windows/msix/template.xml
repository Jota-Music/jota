<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="jota"
        Arguments=""
        InstallLocation="C:\Program Files\Jota">
    </Installer>
    <PackageInformation
        PackageName="Jota"
        PackageDisplayName="Jota"
        PublisherName="CN=Jota"
        PublisherDisplayName="Jota"
        Version="0.1.0.0"
        PackageDescription="Self-hosted music streaming app">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.jotamusic.jota"
                Description="Self-hosted music streaming app"
                DisplayName="Jota"
                ExecutableName="jota"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Jota</DisplayName>
            <PublisherDisplayName>Jota</PublisherDisplayName>
            <Description>Self-hosted music streaming app</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="jota.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
