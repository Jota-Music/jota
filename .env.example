# Spotify OAuth client ID. Leave empty to use the bundled librespot default
# (which allows redirect to http://127.0.0.1:{port}/login on any localhost port).
# To use your own Spotify dev app, set this to its client ID and register
# a localhost redirect URI in the Spotify dashboard.
SPOTIFY_CLIENT_ID=

# Dev-only relay override. When RELAY_API_URL is set, the app uses this relay
# (and RELAY_API_TOKEN, if the relay requires one) instead of the relay saved in
# the UI, so jams and saved rooms can be tested against a local relay.
RELAY_API_URL=
RELAY_API_TOKEN=
